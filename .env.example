# Copy to .env (git-ignored). Everything here is optional; defaults are shown.

# Frontend: where the chat UI sends requests.
VITE_API_URL=http://127.0.0.1:8000

# Backend: comma-separated origins allowed to call the API.
UPSCALE_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost

# Backend: optional CoinGecko demo API key for market data (works without one, at lower rate limits).
UPSCALE_COINGECKO_API_KEY=

# Backend: Anthropic API key for the Vision agent (reads chart screenshots with Claude).
# Without it, screenshot analysis reports "unavailable" and everything else still works.
# (Leave it commented out if you use `ant auth login` instead; an empty value overrides it.)
# ANTHROPIC_API_KEY=
# Backend: optional vision model override (default: claude-opus-5).
# UPSCALE_VISION_MODEL=claude-opus-5

# Backend: News & Sentiment agent. News comes from publishers' public RSS feeds; no news API
# key is needed. Defaults: CoinDesk and Decrypt, whose terms allow personal, non-commercial
# use only. Only feed headlines, links, times and short descriptions are read (never full
# articles). Claude receives each article's headline, publisher and publication time.
# Sentiment labels use the same Anthropic credentials as Vision; without them, real
# articles are still shown but left unclassified.
# Optional: switch off default feeds by name (comma-separated).
# UPSCALE_NEWS_DISABLED_FEEDS=Decrypt
# Optional: replace the feed list. Check each publisher's terms first. The optional third
# field sets what Claude may see: none (show only, never sent to Claude), headline (default),
# or description (also the feed's short description).
# UPSCALE_NEWS_FEEDS=Name|https://feed-url,Other|https://other-feed-url|none
# Optional: model that labels news sentiment (default: claude-opus-5).
# UPSCALE_NEWS_MODEL=claude-opus-5

# Backend: Solana on-chain token safety (mint/freeze authorities, holder concentration) for
# tokens identified by mint. Helius is preferred: its API also counts holders. Any other
# Solana JSON-RPC URL works too (no holder counts). Without either, on-chain safety is
# reported as unavailable and new DEX tokens stay on WAIT. Keys are never logged.
# UPSCALE_HELIUS_API_KEY=
# UPSCALE_SOLANA_RPC_URL=https://your-rpc.example

# Backend: Scout (token discovery). Snapshots go to a local SQLite file (default
# ~/.upscale/scout.sqlite3). Optional JSON overrides Scout's validated thresholds.
# UPSCALE_SCOUT_DB=/path/to/scout.sqlite3
# UPSCALE_SCOUT_CONFIG={"chains": ["solana", "base"], "filters": {"min_liquidity_usd": 5000}}
