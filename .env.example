# Copy to .env (git-ignored). Everything here is optional; defaults are shown.

# Frontend: where the chat UI sends requests.
VITE_API_URL=http://127.0.0.1:8000

# Backend: comma-separated origins allowed to call the API.
UPSCALE_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost

# Backend: optional CoinGecko demo API key for market data (works without one, at lower rate limits).
UPSCALE_COINGECKO_API_KEY=

# Backend: Anthropic API key for the Vision agent (reads chart screenshots with Claude).
# Without it, screenshot analysis reports "unavailable" and everything else still works.
# (Leave it commented out if you use `ant auth login` instead; an empty value overrides it.)
# ANTHROPIC_API_KEY=
# Backend: optional vision model override (default: claude-opus-5).
# UPSCALE_VISION_MODEL=claude-opus-5

# Backend: News & Sentiment agent. News comes from publishers' public RSS feeds; no news API
# key is needed. Defaults: CoinDesk and Decrypt, whose terms allow personal, non-commercial
# use only. Only feed headlines, links, times and short descriptions are read (never full
# articles). Claude receives each article's headline, publisher and publication time.
# Sentiment labels use the same Anthropic credentials as Vision; without them, real
# articles are still shown but left unclassified.
# Optional: switch off default feeds by name (comma-separated).
# UPSCALE_NEWS_DISABLED_FEEDS=Decrypt
# Optional: replace the feed list. Check each publisher's terms first. The optional third
# field sets what Claude may see: none (show only, never sent to Claude), headline (default),
# or description (also the feed's short description).
# UPSCALE_NEWS_FEEDS=Name|https://feed-url,Other|https://other-feed-url|none
# Optional: model that labels news sentiment (default: claude-opus-5).
# UPSCALE_NEWS_MODEL=claude-opus-5

# Backend: Solana on-chain token safety (mint/freeze authorities, holder concentration) for
# tokens identified by mint. Helius is preferred: its API also counts holders. Any other
# Solana JSON-RPC URL works too (no holder counts). Without either, on-chain safety is
# reported as unavailable and new DEX tokens stay on WAIT. Keys are never logged.
# UPSCALE_HELIUS_API_KEY=
# UPSCALE_SOLANA_RPC_URL=https://your-rpc.example

# Backend: Scout (token discovery). Snapshots go to a local SQLite file (default
# ~/.upscale/scout.sqlite3). Optional JSON overrides Scout's validated thresholds.
# UPSCALE_SCOUT_DB=/path/to/scout.sqlite3
# UPSCALE_SCOUT_CONFIG={"chains": ["solana", "base"], "filters": {"min_liquidity_usd": 5000}}
# Background Scout: the regular Scout scan every N minutes while the backend runs (on by
# default, lowest priority on every provider quota). 0 switches it off.
# UPSCALE_BACKGROUND_SCOUT=1
# UPSCALE_BACKGROUND_SCOUT_INTERVAL_MINUTES=30

# Point-in-Time Evidence Archive (for Replay Lab): archives evidence production already
# fetched (market, DEX, on-chain safety, social, Growth Scout, Analyze); adds no provider
# requests. On by default (0 disables). Default file: evidence.sqlite3 next to UPSCALE_SCOUT_DB.
# UPSCALE_EVIDENCE_ARCHIVE=1
# UPSCALE_EVIDENCE_DB=/data/evidence.sqlite3
# Optional on-chain safety enrichment of Scout candidates: NEW Solana RPC / Helius requests,
# lowest production priority, at most N tokens per scan (default 3, max 20). Off by default.
# UPSCALE_EVIDENCE_SAFETY_ENRICHMENT=0
# UPSCALE_EVIDENCE_SAFETY_MAX_PER_REFRESH=3

# Shadow / Paper Strategy Engine: simulated strategies over the Evidence Archive (no orders,
# keys, signing or provider requests). OFF by default; 1 runs it in the background at the
# lowest priority. Default file: shadow.sqlite3 next to UPSCALE_SCOUT_DB. The background run
# starts no earlier than the clean-data cutoff 2026-09-30T05:50:00Z.
# UPSCALE_SHADOW=0
# UPSCALE_SHADOW_DB=/data/shadow.sqlite3
# UPSCALE_SHADOW_INTERVAL_MINUTES=15
# UPSCALE_SHADOW_RUN=production
# UPSCALE_SHADOW_SINCE=2026-09-30T05:50:00Z
# Rejection diagnostics storage. Funnel / diagnostics counts come from exact aggregate
# counters in every mode; only per-candidate rejection rows differ: sampled (default: at
# most N rows per strategy, primary reason and UTC day), full (one row per rejected
# evaluation, one-off research runs only) or aggregate (no rows). Retention (unset / 0:
# disabled) deletes sampled rejection rows older than N days; nothing else is ever deleted.
# UPSCALE_SHADOW_DIAGNOSTICS_DETAIL=sampled
# UPSCALE_SHADOW_REJECTION_SAMPLE_PER_REASON=20
# UPSCALE_SHADOW_REJECTION_RETENTION_DAYS=

# Backend: Scout social / attention evidence (never a BUY / SELL signal). All optional;
# a provider without access is reported as "not configured" and Scout keeps working.
# Reddit Data API: requires an application approved under Reddit's Responsible Builder Policy.
# UPSCALE_REDDIT_CLIENT_ID=
# UPSCALE_REDDIT_CLIENT_SECRET=
# UPSCALE_REDDIT_USER_AGENT=UpScale/0.1 (by u/your-username)
# Farcaster search through Neynar (API key; searches consume Neynar credits).
# UPSCALE_NEYNAR_API_KEY=
# X recent search (official API v2, pay-per-use: about $0.005 per post read, $0.010 per
# user object; no free tier). It also needs {"x_allow_paid": true} below. Reads are capped
# per run (x_max_reads_per_run, default 200) and per UTC day (x.max_results_per_day,
# default 2000); author usernames (billed user reads) only with {"x_fetch_usernames": true}.
# Also set a spending limit in the X Developer Console.
# UPSCALE_X_BEARER_TOKEN=
# Public Discourse forums whose terms allow automated reading (comma-separated).
# UPSCALE_SOCIAL_FORUMS=https://forum.example.org
# Optional JSON overriding validated social thresholds.
# UPSCALE_SOCIAL_CONFIG={"momentum": {"min_mentions": 5}, "x_allow_paid": false}

# Growth Scout ranking (discovery only, never BUY / SELL): weights, stages, discovery mode.
# UPSCALE_GROWTH_CONFIG={"mode": "NEW_AND_EARLY", "safety": {"top_k": 10}}
